# Keep in step with required-version in pyproject.toml; bump tag and digest together.
FROM ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 AS uv

FROM python:3.12.12-alpine

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 
ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/
# uv installs the locked dependencies straight into the image's Python
# (/usr/local), so python, gunicorn and celery resolve exactly as with pip.
ENV UV_PROJECT_ENVIRONMENT=/usr/local
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_CACHE=1
# grpcio ships its own roots.pem, which still trusts emSign ECC Root CA - G3 (eMudhra incident);
# point it at the system bundle, which the OS update below keeps current.
ENV GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt

# OS security updates. --available forces reinstall from the current repos;
# bump APK_SECURITY_PATCH to bust buildx's cached layer (keyed on this command
# string), otherwise a rebuild silently re-ships the old packages.
ARG APK_SECURITY_PATCH=2026-10-26
RUN echo "apk-security-patch ${APK_SECURITY_PATCH}" && apk update && apk upgrade --available

WORKDIR /code

RUN apk add --no-cache --upgrade \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

COPY pyproject.toml uv.lock ./
RUN apk add --no-cache libffi-dev
# uv is bind-mounted for this step only, so the binary never ships in the image.
# --inexact keeps the base image's own packages (pip) in place.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    apk add --no-cache --virtual .build-deps \
    "bash~=5.3" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers" \
    && \
    uv sync --locked --inexact --no-default-groups --group production \
    && \
    # Remove only these bundled documentation examples in the installation layer;
    # retain SDK code and all service models used for requests and signing.
    test -f /usr/local/lib/python3.12/site-packages/botocore/data/iam/2010-05-08/examples-1.json \
    && test -f /usr/local/lib/python3.12/site-packages/botocore/data/sts/2011-06-15/examples-1.json \
    && test -f /usr/local/lib/python3.12/site-packages/boto3/examples/cloudfront.rst \
    && rm /usr/local/lib/python3.12/site-packages/botocore/data/iam/2010-05-08/examples-1.json \
          /usr/local/lib/python3.12/site-packages/botocore/data/sts/2011-06-15/examples-1.json \
          /usr/local/lib/python3.12/site-packages/boto3/examples/cloudfront.rst \
    && \
    # Offline smoke check: S3 signing, paginator, waiter and a stubbed request,
    # plus IAM/STS client model loading, with explicit synthetic credentials.
    AWS_EC2_METADATA_DISABLED=true AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null \
    python -c 'import socket; socket.socket.connect = lambda *a, **k: (_ for _ in ()).throw(RuntimeError("network disabled")); import boto3; from botocore.stub import Stubber; s = boto3.Session(aws_access_key_id="local-placeholder", aws_secret_access_key="local-placeholder", region_name="us-east-1"); c = s.client("s3", endpoint_url="http://127.0.0.1:19999"); assert c.generate_presigned_url("get_object", Params={"Bucket":"test-bucket", "Key":"example"}); assert c.generate_presigned_post("test-bucket", "example")["fields"]; assert c.get_paginator("list_objects_v2") and c.get_waiter("object_exists"); stub = Stubber(c); stub.add_response("put_object", {"ETag":"stubbed"}, {"Bucket":"test-bucket", "Key":"example", "Body":b"example"}); stub.activate(); assert c.put_object(Bucket="test-bucket", Key="example", Body=b"example")["ETag"] == "stubbed"; stub.deactivate(); assert s.client("iam") and s.client("sts")' \
    && \
    apk del .build-deps \
    && \
    rm -rf /var/cache/apk/*

# pip is build tooling only; uv installed everything above and nothing installs
# at runtime. The base image's pip (25.0.1) vendors a certifi that still trusts
# the compromised emSign G3 root (GHSA-6q48-6c7w-9gw2). `python -m ensurepip`
# restores it if ever needed.
RUN rm -rf /usr/local/lib/python3.12/site-packages/pip \
           /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12


# Add in Django deps and generate Django's static files
COPY manage.py manage.py
COPY plane plane/
COPY templates templates/
COPY package.json package.json

RUN apk --no-cache add "bash~=5.3"
COPY ./bin ./bin/

RUN mkdir -p /code/plane/logs
RUN chmod +x ./bin/*
RUN chmod -R 777 /code

# Expose container port and run entry point script
EXPOSE 8000

CMD ["./bin/docker-entrypoint-api.sh"]
